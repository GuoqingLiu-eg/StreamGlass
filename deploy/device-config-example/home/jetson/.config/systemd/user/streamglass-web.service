[Unit]
Description=StreamGlass local web control surface
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
EnvironmentFile=-%h/.config/streamglass/realtime.env
# Listen on all interfaces, including the configured USB gadget interface.
Environment=STREAMGLASS_WEB_HOST=0.0.0.0
Environment=STREAMGLASS_WEB_PORT=8080
ExecStart=/bin/bash -lc 'exec python3 -u "$STREAMGLASS_PROJECT_DIR/ui-prototype/server.py"'
Restart=on-failure
RestartSec=2
StandardOutput=append:/dev/shm/streamglass-web.log
StandardError=append:/dev/shm/streamglass-web.log
UMask=0077

[Install]
WantedBy=default.target
